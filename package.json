{
  "name": "origin-gates-workspace",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["packages/narrative-engine", "packages/origin-gates"],
  "scripts": {
    "dev": "npm run build:engine && node scripts/dev.mjs",
    "build:engine": "npm run build --workspace=@origin-gates/narrative-engine",
    "build": "npm run build --workspace=@origin-gates/game",
    "test": "npm run build:engine && vitest run",
    "typecheck": "npm run build:engine && npm run typecheck --workspaces && tsc --noEmit",
    "test:consumer": "npm run build:engine && node scripts/check-consumer.mjs"
  },
  "devDependencies": { "typescript": "^5.9.3", "vitest": "^5.1.0", "@types/node": "^22.12.0" }
}
